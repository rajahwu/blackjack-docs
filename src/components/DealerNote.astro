---
import phrasePanelBg from "../assets/phrase-panel-bg.svg";

const { title = "Dealer Note", icon = "🎯" } = Astro.props;
---

<section class="dealer-note" role="note" aria-label={title}>
  <div class="note-header">
    <span class="icon" aria-hidden="true">{icon}</span>
    <h3 id={`note-${title.toLowerCase().replace(/\s+/g, "-")}`}>{title}</h3>
  </div>
  <div class="note-body">
    <slot />
  </div>
</section>

<style>
  .dealer-note {
    position: relative;
    background: url("{phrasePanelBg.src}") center/cover no-repeat;
    border-radius: 12px;
    padding: 1.5rem 2rem;
    margin: 2rem 0;
    color: #f5f5f5;
    box-shadow: 0 0 20px rgba(0, 230, 168, 0.25);
    border: 1px solid rgba(0, 230, 168, 0.2);
    backdrop-filter: blur(6px);
    transition:
      box-shadow 0.3s ease,
      transform 0.2s ease;
  }

  .dealer-note:hover {
    box-shadow: 0 0 30px rgba(0, 230, 168, 0.5);
    transform: translateY(-2px);
  }

  .note-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .note-header .icon {
    font-size: 1.5rem;
  }

  .note-header h3 {
    font-size: 1.2rem;
    color: #00e6a8;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .note-body {
    font-size: 1rem;
    line-height: 1.6;
  }

  .note-body p {
    margin: 0.3rem 0;
  }
</style>
