---
import "../styles/dealer-note.css";
import PhrasePanelBg from "../assets/phrase-panel-bg.svg";

const { title = "Dealer Note", icon = "🎯" } = Astro.props;
---

<section class="dealer-note">
  <div class="note-header">
    <span class="icon">{icon}</span>
    <h3>{title}</h3>
  </div>
  <div class="note-body">
    <slot />
  </div>
</section>

<style define:vars={{ PhrasePanelBg: `url(${PhrasePanelBg.src})` }}>
  section.dealer-note {
    background: var(--PhrasePanelBg) center/cover no-repeat;
  }
</style>
