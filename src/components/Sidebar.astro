---
import '../styles/navigaton.css';
import dealerBadge from "../assets/dealer-badge.svg";

const currentPath = Astro.url.pathname;

// Helper to check if a link is active
const isActive = (path: string) => {
  if (path === '/blackjack/overview') {
    return currentPath === path;
  }
  return currentPath.startsWith(path);
};

const links = [
  { href: "/blackjack/overview", label: "Overview" },
  { href: "/blackjack/drills", label: "Dealer Drills" },
  { href: "/blackjack/phrasebook", label: "Phrasebook" },
  { href: "/blackjack/trainer-notes", label: "Trainer Notes" },
];
---

<aside class="sidebar">
  <div class="dealer-badge">
    <img src={dealerBadge.src} alt="Dealer Badge" />
    <span class="badge-label">GTTM Training</span>
  </div>

  <nav class="sidebar-nav">
    {links.map(link => (
      <a 
        href={link.href} 
        class:list={['nav-link', { active: isActive(link.href) }]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</aside>

