---
import dealerBadge from "../assets/dealer-badge.svg";
const currentPath = Astro.url.pathname;

const links = [
  { href: "/blackjack/overview", label: "Overview" },
  { href: "/blackjack/drills", label: "Drills" },
  { href: "/blackjack/phrasebook", label: "Phrasebook" },
  { href: "/blackjack/trainer-note", label: "Trainer Notes" },
];
---

<nav class="sidebar">
  <div class="sidebar-header">
    <img src={dealerBadge.src} alt="Dealer Badge" class="dealer-badge" />
    <h2>🎴 Blackjack Docs</h2>
  </div>

  <ul>
    {
      links.map((link) => (
        <a
          href={link.href}
          class={`nav-link ${currentPath.startsWith(link.href) ? "active" : ""}`}
        >
          {link.label}
        </a>
      ))
    }
  </ul>

  <footer class="sidebar-footer">
    <p>GTTM · Dealer Mode</p>
  </footer>
</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100vh;
    padding: 1.5rem;
    background: linear-gradient(
      180deg,
      rgba(15, 17, 23, 0.9),
      rgba(90, 75, 255, 0.2)
    );
    border-right: 2px solid rgba(0, 230, 168, 0.3);
    box-shadow: inset -4px 0 12px rgba(0, 230, 168, 0.15);
  }

  .sidebar-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid rgba(0, 230, 168, 0.3);
    padding-bottom: 1rem;
  }

  .dealer-badge {
    width: 90px;
    filter: drop-shadow(0 0 6px rgba(0, 230, 168, 0.6));
  }

  .sidebar-header h2 {
    font-size: 1.1rem;
    color: #00e6a8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    text-align: center;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  li {
    margin: 0.5rem 0;
  }

  .nav-link {
    display: block;
    color: #f5f5f5;
    text-decoration: none;
    font-weight: 500;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .nav-link:hover {
    background-color: rgba(0, 230, 168, 0.1);
    color: #00e6a8;
    box-shadow: 0 0 10px rgba(0, 230, 168, 0.3);
  }

  .nav-link.active {
    background-color: rgba(0, 230, 168, 0.2);
    color: #00e6a8;
    border-left: 3px solid #00e6a8;
  }

  .sidebar-footer {
    border-top: 1px solid rgba(0, 230, 168, 0.3);
    margin-top: 1rem;
    padding-top: 1rem;
    text-align: center;
    font-size: 0.8rem;
    color: rgba(245, 245, 245, 0.7);
  }
</style>
