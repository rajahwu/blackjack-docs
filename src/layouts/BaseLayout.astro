---
const { title } = Astro.props;
import RouteDebugger from "../components/react/RouteDebugger";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title ? `${title} | Blackjack Docs` : "Blackjack Docs"}</title>
    <ClientRouter />
  </head>
  <body class="font-sans bg-black text-white min-h-screen">
    <slot />
    <RouteDebugger />
  </body>
</html>

<style>
  body {
    width: 100%;
    min-width: 100%;
    overflow-x: hidden;
  }
</style>
