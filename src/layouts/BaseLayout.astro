---
const { title } = Astro.props;
import RouteDebugger from "../components/react/RouteDebugger";
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title ? `${title} | Blackjack Docs` : "Blackjack Docs"}</title>
  </head>
  <body class="font-sans bg-black text-white min-h-screen">
    <slot />
    <RouteDebugger />
  </body>
</html>
