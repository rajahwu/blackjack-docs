---
import BaseLayout from "./BaseLayout.astro";
import tableFelt from "../../assets/table-felt.svg";

const { title, description } = Astro.props;
---

<BaseLayout title={title}>
  <main class="sheet">
    <header class="sheet-header">
      <svg
        class="hud-grid"
        viewBox="0 0 1920 1080"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <pattern
            id="grid"
            width="80"
            height="80"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M 80 0 L 0 0 0 80"
              fill="none"
              stroke="#00E6A8"
              stroke-width="1"></path>
          </pattern>
        </defs>
        <rect width="1920" height="1080" fill="url(#grid)" fill-opacity="0.3"
        ></rect>
      </svg>
      <h1>{title}</h1>
      {description && <p class="sheet-desc">{description}</p>}
      <svg
        width="500"
        height="20"
        viewBox="0 0 500 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#5A4BFF;stop-opacity:1"></stop>
            <stop offset="100%" style="stop-color:#00E6A8;stop-opacity:1"
            ></stop>
          </linearGradient>
        </defs>
        <rect width="500" height="20" rx="10" fill="url(#grad)"></rect>
      </svg>
    </header>

    <article class="sheet-body">
      <slot />
    </article>
  </main>
</BaseLayout>

<style define:vars={{ tableFelt: `url(${tableFelt.src})` }}>
  :root {
    --felt-bg: url("/src/assets/table-felt.svg");
    --accent-cyan: #00e6a8;
    --accent-violet: #5a4bff;
    --text-light: #f5f5f5;
    --text-dim: #b3b3b3;
  }

  .sheet {
    background: var(--tableFelt) center/cover no-repeat;
    color: var(--text-light);
    min-height: 100vh;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sheet-header {
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
  }

  .sheet-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.04em;
    margin: 1rem 0;
  }

  .sheet-header .sheet-desc {
    color: var(--text-dim);
    font-size: 1.1rem;
  }

  .hud-grid {
    opacity: 0.3;
    width: 100%;
    max-width: 800px;
  }

  .hud-bar {
    margin-top: 1rem;
    width: 100%;
    max-width: 600px;
  }

  .sheet-body {
    background: rgba(15, 17, 23, 0.75);
    border: 1px solid rgba(0, 230, 168, 0.2);
    box-shadow: 0 0 30px rgba(0, 230, 168, 0.25);
    border-radius: 1rem;
    padding: 2rem 3rem;
    width: 100%;
    max-width: 900px;
    line-height: 1.7;
  }

  .sheet-body h2,
  .sheet-body h3 {
    color: var(--accent-cyan);
    margin-top: 2rem;
    border-bottom: 1px solid rgba(90, 75, 255, 0.4);
    padding-bottom: 0.3rem;
  }

  .sheet-body table {
    width: 100%;
    margin-top: 1rem;
    border-collapse: collapse;
  }

  .sheet-body th,
  .sheet-body td {
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem 0.75rem;
  }

  .sheet-body th {
    background: rgba(90, 75, 255, 0.15);
    color: var(--accent-cyan);
  }
</style>
