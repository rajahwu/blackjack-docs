---
// src/layouts/RehearsalSheetLayout.astro
import "../styles/dealer-note.css";
import "../styles/drill-sheet.css";
import "../styles/rehearsal-sheet.css";
// import tableFelt from "../assets/felt-texture.png";
import bgPattern from "../assets/background.svg";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    tags?: string[];
    difficulty?: "beginner" | "intermediate" | "advanced";
  };
}

const { frontmatter } = Astro.props;
const {
  title,
  description = "",
  tags = [],
  difficulty = "beginner",
} = frontmatter;
---

<BaseLayout title={title} description={description}>
  <main class="sheet container mx-auto px-4">
    <header class="sheet-header">
      <svg
        class="hud-grid"
        viewBox="0 0 1920 1080"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <pattern
            id="grid"
            width="80"
            height="80"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M 80 0 L 0 0 0 80"
              fill="none"
              stroke="#00E6A8"
              stroke-width="1"></path>
          </pattern>
        </defs>
        <rect width="1920" height="1080" fill="url(#grid)" fill-opacity="0.3"
        ></rect>
      </svg>
      <div class="">
        <span class="difficulty-badge {difficulty}">{difficulty}</span>
        <h1 class="drill-title">{title}</h1>
        {description && <p class="sheet-description">{description}</p>}
        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag: String) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
      <svg
        class="hud-bar"
        width="500"
        height="20"
        viewBox="0 0 500 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#5A4BFF;stop-opacity:1"></stop>
            <stop offset="100%" style="stop-color:#00E6A8;stop-opacity:1"
            ></stop>
          </linearGradient>
        </defs>
        <rect width="500" height="20" rx="10" fill="url(#grad)"></rect>
      </svg>
    </header>
    <article class="sheet-body">
      <slot />
    </article>
  </main>
</BaseLayout>

<style define:vars={{ bgPattern: `url(${bgPattern.src})` }}>
  main.sheet {
    background-image: var(--bgPattern) center/cover no-repeat;
  }
</style>
