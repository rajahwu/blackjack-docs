---
// src/layouts/RehearsalSheetLayout.astro
import "../styles/dealer-note.css";
import "../styles/drill-sheet.css";
// import tableFelt from "../assets/felt-texture.png";
import bgPattern from "../assets/background.svg";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    tags?: string[];
    difficulty?: "beginner" | "intermediate" | "advanced";
  };
}

const { frontmatter } = Astro.props;
const {
  title,
  description = "",
  tags = [],
  difficulty = "beginner",
} = frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="drill-sheet">
    <header class="drill-header">
      <div class="header-content">
        <span class="difficulty-badge {difficulty}">{difficulty}</span>
        <h1 class="drill-title">{title}</h1>
        {description && <p class="drill-description">{description}</p>}
        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag: String) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="drill-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style define:vars={{ bgPattern: `url(${bgPattern.src})` }}>
  article.drill-sheet {
    background: var(--bgPattern) center/cover no-repeat;
  }
</style>
