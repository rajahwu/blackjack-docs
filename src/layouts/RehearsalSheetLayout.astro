---
// This is the layout for an individual drill page.
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

type Props = {
  // This frontmatter prop is automatically passed
  // by the dynamic page using layout: ...
  frontmatter: CollectionEntry<'dealer-guides'>['data'];
};

const { frontmatter } = Astro.props;
const { title, description, tags, difficulty } = frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="drill-sheet">
    <header class="drill-header">
      <div class="header-content">
        <span class="difficulty-badge {difficulty}">{difficulty}</span>
        <h1 class="drill-title">{title}</h1>
        <p class="drill-description">{description}</p>
        <div class="tags">
          {tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    </header>

    <div class="drill-content">
      <!-- This is where the MD/MDX content will go -->
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
    .drill-header {
        padding: 2.5rem;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(90, 75, 255, 0.2), rgba(0, 230, 168, 0.1));
        border: 1px solid var(--border-color-dim);
        margin-bottom: 2.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0, 0.2);
    }

    .difficulty-badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: capitalize;
        margin-bottom: 1rem;
    }

    .difficulty-badge.beginner {
        background: rgba(0, 230, 168, 0.2);
        color: #00e6a8;
    }
    .difficulty-badge.intermediate {
        background: rgba(255, 165, 0, 0.2);
        color: #ffa500;
    }
    .difficulty-badge.advanced {
        background: rgba(255, 0, 0, 0.2);
        color: #ff4d4d;
    }

    .drill-title {
        font-size: 2.8rem;
        color: #f5f5f5;
        margin: 0 0 1rem 0;
    }

    .drill-description {
        font-size: 1.2rem;
        color: #b3b3b3;
        margin: 0 0 1.5rem 0;
        max-width: 700px;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        display: inline-block;
        background: rgba(255, 255, 255, 0.1);
        color: #f5f5f5;
        padding: 0.25rem 0.6rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    /* Styles for the MD/MDX content */
    .drill-content {
        line-height: 1.7;
        font-size: 1.1rem;
        color: #b3b3b3;
    }

    .drill-content :global(h2) {
        font-size: 1.8rem;
        color: var(--accent);
        margin: 2.5rem 0 1rem;
        border-bottom: 2px solid var(--purple);
        padding-bottom: 0.5rem;
    }

    .drill-content :global(h3) {
        font-size: 1.4rem;
        color: var(--accent);
        margin: 2rem 0 1rem;
    }

    .drill-content :global(p) {
        margin: 1rem 0;
    }

    .drill-content :global(ul),
    .drill-content :global(ol) {
        margin: 1rem 0;
        padding-left: 2rem;
    }

    .drill-content :global(li) {
        margin: 0.5rem 0;
    }

    .drill-content :global(code) {
        background: rgba(0,0,0, 0.3);
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
    }

    .drill-content :global(strong) {
        color: #f5f5f5;
        font-weight: 600;
    }
</style>
