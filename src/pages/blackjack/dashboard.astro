---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

const logs = await getCollection("traininglog");

// Sort newest first
const sortedLogs = logs.sort(
  (a, b) => new Date(b.id).getTime() - new Date(a.id).getTime()
);

// Aggregate stats
const totalSessions = sortedLogs.length;
const totalMinutes = sortedLogs.reduce(
  (sum, log) => sum + (log.data.durationMinutes || 0),
  0
);

const streak = (() => {
  // optional simple streak detector (consecutive days)
  const dates = sortedLogs.map((l) => new Date(l.id));
  let max = 0,
    cur = 1;
  for (let i = 1; i < dates.length; i++) {
    const diff =
      (dates[i - 1].getTime() - dates[i].getTime()) / (1000 * 60 * 60 * 24);
    if (diff <= 1.1) cur++;
    else {
      max = Math.max(max, cur);
      cur = 1;
    }
  }
  return Math.max(max, cur);
})();
---

<MainLayout title="Dealer Training Dashboard">
  <div class="min-h-screen bg-[url('/felt-texture.jpg')] bg-cover text-white p-8">
    <div class="bg-black/60 border border-green-700 rounded-3xl p-8 shadow-2xl backdrop-blur-md max-w-5xl mx-auto">
      <header class="mb-8 text-center">
        <h1 class="text-3xl font-bold mb-2 text-green-300 drop-shadow-[0_0_8px_#22c55e]">
          🎴 Dealer Training Dashboard
        </h1>
        <p class="text-gray-300">
          Track your blackjack drills and performance progress.
        </p>
      </header>

      <!-- Summary Cards -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <div class="bg-black/50 border border-green-600 rounded-xl p-4 text-center shadow-inner">
          <div class="text-2xl font-bold text-green-400">{totalSessions}</div>
          <div class="text-sm text-gray-400">Sessions Logged</div>
        </div>
        <div class="bg-black/50 border border-green-600 rounded-xl p-4 text-center shadow-inner">
          <div class="text-2xl font-bold text-green-400">{totalMinutes}</div>
          <div class="text-sm text-gray-400">Total Minutes</div>
        </div>
        <div class="bg-black/50 border border-green-600 rounded-xl p-4 text-center shadow-inner">
          <div class="text-2xl font-bold text-green-400">{streak}</div>
          <div class="text-sm text-gray-400">Day Streak</div>
        </div>
      </section>

      <!-- Training Log Table -->
      <section>
        <h2 class="text-xl mb-4 font-semibold text-green-300">
          📅 Recent Sessions
        </h2>
        <div class="overflow-x-auto rounded-xl border border-green-700">
          <table class="min-w-full text-left text-sm border-collapse">
            <thead class="bg-green-900/40 text-green-200 uppercase text-xs tracking-wider">
              <tr>
                <th class="px-4 py-2">Date</th>
                <th class="px-4 py-2">Focus</th>
                <th class="px-4 py-2">Duration</th>
                <th class="px-4 py-2">Notes</th>
              </tr>
            </thead>
            <tbody>
              {sortedLogs.map((log) => (
                <tr
                  class="border-t border-green-800 hover:bg-green-900/20 transition-colors"
                >
                  <td class="px-4 py-2 font-medium">
                    {log.id.replace(".json", "")}
                  </td>
                  <td class="px-4 py-2">{log.data.focus || "—"}</td>
                  <td class="px-4 py-2">
                    {log.data.durationMinutes ?? "—"} min
                  </td>
                  <td class="px-4 py-2 text-gray-300">
                    {log.data.notes || ""}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <footer class="mt-10 text-center text-sm text-gray-400">
        <a href="/blackjack/drills" class="underline text-green-400 hover:text-green-200">
          ← Back to Drills
        </a>
      </footer>
    </div>
  </div>
</MainLayout>
