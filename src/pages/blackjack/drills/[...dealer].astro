---
import { getCollection, getEntryBySlug } from "astro:content";
import RehearsalSheetLayout from "../../../layouts/RehearsalSheetLayout.astro";

export async function getStaticPaths() {
  const guides = await getCollection("dealer-guides");

  return guides.map((guide) => ({
    params: { dealer: guide.slug }, // this must match the [..dealer] param
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();
---

<RehearsalSheetLayout title={guide.data.title} description={guide.data.description}>
  <Content />
</RehearsalSheetLayout>
