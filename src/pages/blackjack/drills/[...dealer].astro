---
// This dynamic page fetches and renders a single drill
import { getCollection } from 'astro:content';
import RehearsalSheetLayout from '../../../layouts/RehearsalSheetLayout.astro';

// 1. This function is required for static site generation
// It tells Astro which paths to build
export async function getStaticPaths() {
  const allDrills = await getCollection('dealer-guides');
  
  return allDrills.map(drill => ({
    params: { dealer: drill.slug },
    props: { drill },
  }));
}

// 2. Get the specific drill for this page
const { drill } = Astro.props;
const { Content } = await drill.render();
---

<!-- 3. Render the layout and pass the MDX content -->
<RehearsalSheetLayout frontmatter={drill.data}>
  <Content />
</RehearsalSheetLayout>
