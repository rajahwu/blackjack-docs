---
// src/pages/blackjack/drills/[dealer].astro
import '../../../styles/dealer-note.css';
import '../../../styles/drill-sheet.css';
import '../../../styles/guide.css';
import { getCollection } from 'astro:content';
import RehearsalSheetLayout from '../../../layouts/RehearsalSheetLayout.astro';

export async function getStaticPaths() {
  const dealerGuides = await getCollection('dealer-guides');
  
  return dealerGuides.map((entry) => ({
    params: { dealer: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const frontmatter = {
  title: entry.data.title,
  description: entry.data.description || '',
  tags: entry.data.tags || [],
  difficulty: entry.data.difficulty,
};
---

<RehearsalSheetLayout frontmatter={frontmatter}>
  <Content />
</RehearsalSheetLayout>