---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import CardValueTrainer from "../../../components/CardValueTrainer.astro";

const guides = await getCollection("dealer-guides");
---

<BaseLayout title="Dealer Drills">
  <section class="header">
    <h1>Dealer Rehearsal Sheets</h1>
    <p class="intro">
      Practice your dealing routines and refresh your card handling timing.  
      Use the Card Value Trainer below to warm up before each session.
    </p>
  </section>

  <!-- Interactive trainer -->
  <section class="trainer">
    <h2>Card Value Trainer</h2>
    <CardValueTrainer client:load />
  </section>

  <!-- List of all rehearsal sheets -->
  <section class="guide-list">
    <h2>Rehearsal Sheets</h2>
    <ul>
      {guides.map(guide => (
        <li>
          <a href={`/blackjack/drills/${guide.slug}/`}>
            {guide.data.title}
          </a>
          {guide.data.description && (
            <p class="desc">{guide.data.description}</p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <style>
    .header {
      margin-bottom: 2rem;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      color: #00e6a8;
    }

    .intro {
      color: #ccc;
      max-width: 600px;
      line-height: 1.6;
    }

    .trainer {
      margin: 2rem 0;
      padding: 1.5rem;
      border: 2px solid #00e6a8;
      border-radius: 12px;
      background: rgba(15, 17, 23, 0.8);
      box-shadow: 0 0 20px rgba(90, 75, 255, 0.3);
    }

    .guide-list ul {
      list-style: none;
      padding: 0;
    }

    .guide-list li {
      margin: 1rem 0;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      background: rgba(90, 75, 255, 0.1);
      border: 1px solid rgba(0, 230, 168, 0.3);
      transition: 0.2s ease;
    }

    .guide-list li:hover {
      background: rgba(0, 230, 168, 0.15);
      transform: translateX(4px);
    }

    .guide-list a {
      color: #00e6a8;
      font-weight: bold;
      text-decoration: none;
      font-size: 1.1rem;
    }

    .guide-list .desc {
      margin: 0.3rem 0 0;
      color: #bbb;
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>
