---
import MainLayout from "../../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import CardValueTrainer from "../../../components/react/CardValueTrainer";

// Fetch the collection data directly into the component's script block,
// as this is a static index page, not a dynamic route generator.
const guides = await getCollection("dealer-guides");
---

<MainLayout title="Dealer Drills">
  <section class="header">
    <h1>Dealer Rehearsal Sheets</h1>
    <p class="intro">
      Practice your dealing routines and refresh your card handling timing.  
      Use the Card Value Trainer below to warm up before each session.
    </p>
  </section>

  <!-- Interactive trainer -->
  <section class="trainer">
    <h2>Card Value Trainer</h2>
    <CardValueTrainer client:load />
  </section>

  <!-- List of all rehearsal sheets -->
  <section class="guide-list">
    <h2>Rehearsal Sheets</h2>
    <ul>
      {guides.map(guide => (
        <li>
          <a href={`/blackjack/drills/${guide.slug}/`}>
            {guide.data.title}
          </a>
          {guide.data.description && (
            <p class="desc">{guide.data.description}</p>
          )}
        </li>
      ))}
    </ul>
  </section>
</MainLayout>

  <style>
    /* Added minimal styles for better presentation */
    .header, .trainer, .guide-list {
        padding: 1.5rem 1rem;
        max-width: 800px;
        margin: 0 auto;
    }
    h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    h2 {
        font-size: 1.75rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
        border-bottom: 2px solid #eee;
        padding-bottom: 0.5rem;
    }
    .intro {
        font-size: 1.1rem;
        color: #555;
    }
    .guide-list ul {
        list-style: none;
        padding: 0;
    }
    .guide-list li {
        margin-bottom: 1rem;
        border: 1px solid #ddd;
        padding: 1rem;
        border-radius: 0.5rem;
        transition: background-color 0.2s;
    }
    .guide-list li:hover {
        background-color: #f9f9f9;
    }
    .guide-list a {
        font-size: 1.25rem;
        font-weight: 600;
        color: #007bff;
        text-decoration: none;
        display: block;
    }
    .guide-list a:hover {
        text-decoration: underline;
    }
    .desc {
        margin-top: 0.25rem;
        font-size: 0.9rem;
        color: #666;
    }
  </style>
