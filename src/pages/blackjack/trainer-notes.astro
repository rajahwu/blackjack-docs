---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DealerNote from "../../components/DealerNote.astro";
---

<BaseLayout title="Trainer Notes">
  <h2>Trainer Notes</h2>
  <p>Dealer calls and standard phrases will go here.</p>
  <DealerNote title="Eye Contact" icon="👀">
    Remember to maintain eye contact with players when dealing cards.
  </DealerNote>
  <DealerNote title="Announcing Wins" icon="🏆">
    Use a friendly tone when announcing wins to enhance player experience."
  </DealerNote>
  <DealerNote title="Shuffling" icon="🃏">
    "Practice smooth shuffling techniques to keep the game flowing."
  </DealerNote>
</BaseLayout>
